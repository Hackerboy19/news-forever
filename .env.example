# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL Configuration for jaipurwe_fsianews Database
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ---------------------------------------------------------------------------
# VITE_ASSET_BASE_URL: where the legacy `assets/img/...` uploads are actually
# served from (the old cPanel origin, a CDN, or a media subdomain).
#
# It must NOT be the domain running this app. The database stores relative
# paths, and the app turns them into absolute URLs using this base. If the base
# points back at this origin, every image request misses the filesystem and is
# answered by the SPA instead of the picture — which is what made og:image URLs
# open a news page.
#
# READ THIS BEFORE SETTING IT: anything prefixed VITE_ is inlined into the
# JavaScript bundle by Vite at BUILD time. It is not read at runtime, so
# editing .env and restarting the server changes nothing. After changing it you
# must rebuild and then restart:
#
#     npm run build && npm start        (or: pm2 restart <app>)
#
# Defaults to https://newsforever.in/ when unset, which is the historical
# value. Trailing slash optional.
# ---------------------------------------------------------------------------
VITE_ASSET_BASE_URL=

# ---------------------------------------------------------------------------
# LEGACY_MEDIA_ROOT: the directory on this server that CONTAINS the legacy
# `assets/` and `uploads/` folders — for example /home/<user>/public_html.
#
# If the images already live on this domain, leave VITE_ASSET_BASE_URL alone
# and set this instead. The uploads normally sit where CodeIgniter kept them,
# not inside the app folder, so resolving them against the app's own working
# directory finds nothing and every image 404s even though the files are there.
#
# Unlike VITE_* this is read at RUNTIME, so a restart is enough — no rebuild.
# On boot the server logs the resolved path and whether it found assets/:
#
#     [media] LEGACY_MEDIA_ROOT=/home/x/public_html -> /home/x/public_html/assets (found)
#
# Defaults to the app's working directory.
# ---------------------------------------------------------------------------
LEGACY_MEDIA_ROOT=
